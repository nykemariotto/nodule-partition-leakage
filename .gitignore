# =====================================================================
# .gitignore -- the repository versions the code, the partition indices, the per-sample
# predictions and per-run histories, the cohort tables and the derived results. It excludes the
# raw images, the large regenerable arrays and the model weights. See data/README.md to obtain
# the raw data.
# =====================================================================

# --- raw data (never committed; large and distributed by TCIA under its own terms) ---
LIDC-IDRI/
LNDb/
LNDB/
data/*
!data/README.md
*.rar
*.mhd
*.raw
*.dcm

# --- large, regenerable arrays and weights: the preprocessed .npy tree (~8 GB) and every model
#     checkpoint (~6 GB), both regenerable from the committed code and indices ---
outputs/processed/
*.npy
outputs/models/
outputs/**/*.pt
outputs/**/*.pth
outputs/metadata/*.pkl
outputs/metadata/processed_index_*.csv

# --- logs ---
outputs/logs/
*.log
*.err

# Committed on purpose (not ignored): outputs/splits/ (the partition indices), outputs/probs/
# (per-sample y_true and y_prob for every run), outputs/history/ (per-epoch trajectories with the
# configuration hash), outputs/metadata/ (cohort and accounting tables), and the derived results
# in outputs/results/, outputs/metrics/, outputs/_analysis/ and outputs/figures/.

# --- generated documents: ignored, except the figures the article embeds ---
*.pdf
!figures/*.pdf
!figures/*.png
!outputs/figures/*.pdf

# --- python / os / editors ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
*.egg-info/
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- build output and working copies ---
*.bbl
*.bak
*.bak_*

# --- local working material, not part of the release: the manuscript build tree and notes ---
paper/
docs/

# Literature search: abstracts and raw API responses stay local. Abstracts belong to their
# publishers; the published tables keep identifiers, titles and the decisions taken on each record.
outputs/literature/*/local/
